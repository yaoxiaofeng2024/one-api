# One API 配置文件
# 程序启动时会自动加载此文件中的环境变量（通过 godotenv�?

# ========== 服务端口 ==========
PORT=3000

# ========== MySQL 数据库配�?==========
# 格式：用户名:密码@tcp(主机:端口)/数据库名?参数
# 程序会根�?SQL_DSN 的值自动判断数据库类型�?
#   - �?"postgres://" 开�?�?PostgreSQL
#   - 非空且非 postgres 前缀 �?MySQL
#   - 为空 �?SQLite（默认）
SQL_DSN=root:123456@tcp(localhost:3306)/one-api?charset=utf8mb4&parseTime=True&loc=Local

# 日志数据库（可选，不设置则与主库共用）
# LOG_SQL_DSN=root:123456@tcp(localhost:3306)/one-api-log?charset=utf8mb4&parseTime=True&loc=Local

# ========== Redis 配置 ==========
# 格式：redis://密码@主机:端口/数据库编
# 如果没有密码，格式为：redis://主机:端口/数据库编
REDIS_CONN_STRING=redis://127.0.0.1:6379/0

# Redis 密码（集群模式时使用，单机模式密码写在连接串中即可）
# REDIS_PASSWORD=

# Redis 哨兵/集群模式的主节点名称（不设置则为单机模式
# REDIS_MASTER_NAME=

# ========== 缓存同步配置 ==========
# 内存缓存同步频率（秒），启用 Redis 时必须设置此
SYNC_FREQUENCY=60

# ========== 会话安全 ==========
# 会话密钥（生产环境务必修改为随机字符串）
# SESSION_SECRET=mcv58Rfw4Cg2+PcUMctYCgri+VyBpQH5ThMirM/25z8=

# ========== 可选功能==========
# 调试模式
# DEBUG=false

# 渠道自动测试频率（秒），不设置则不启�?
# CHANNEL_TEST_FREQUENCY=300

# 批量更新模式（高并发写入场景开启）
# BATCH_UPDATE_ENABLED=true
